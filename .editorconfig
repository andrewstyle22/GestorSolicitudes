# Reglas de estilo del proyecto (StyleCop y código).
root = true

# Codificación de los ficheros C#: UTF-8 sin BOM. Los XAML y la documentación se dejan
# como están para no mezclar este cambio con una normalización masiva de codificaciones.
[*.cs]
charset = utf-8
insert_final_newline = true

# Usings sobrantes y namespace de fichero: el estilo del proyecto ya es file-scoped.
dotnet_diagnostic.IDE0005.severity = warning
csharp_style_namespace_declarations = file_scoped:warning
dotnet_diagnostic.IDE0161.severity = warning

# SA1101: prefijar con this. las llamadas a miembros propios.
dotnet_diagnostic.SA1101.severity = warning

# CA1031: los catch generales son deliberados (avisos de E/S y de arranque); no se activa.
dotnet_diagnostic.CA1031.severity = none
# CA1305 y CA1307: los textos usan la cultura de Localizacion.CulturaActual y las
# comparaciones son de claves de UI, no de datos; no se activan.
dotnet_diagnostic.CA1305.severity = none
dotnet_diagnostic.CA1307.severity = none

# StyleCop: documentación obligatoria (familia SA1600-SA1699): no se exige.
# Los comentarios XML existentes se conservan; el analizador simplemente no los impone.
dotnet_analyzer_diagnostic.category-StyleCop.CSharp.DocumentationRules.severity = none
# Cabecera de copyright obligatoria al inicio de cada archivo.
dotnet_diagnostic.SA1633.severity = none
# Orden de miembros por accesibilidad/por estáticos: no encaja con la estructura por secciones del código.
dotnet_diagnostic.SA1201.severity = none
dotnet_diagnostic.SA1202.severity = none
dotnet_diagnostic.SA1203.severity = none
dotnet_diagnostic.SA1204.severity = none
# SA1117/SA1137: no obligar a que los parámetros/argumentos quepan en una sola línea.
dotnet_diagnostic.SA1117.severity = none
dotnet_diagnostic.SA1137.severity = none
# SA1114/SA1115/SA1515: los diccionarios de traducciones (Localizacion.cs) son listas
# de tuplas una por línea; estas reglas de "parámetro en su propia línea" no aportan ahí.
dotnet_diagnostic.SA1114.severity = none
dotnet_diagnostic.SA1115.severity = none
dotnet_diagnostic.SA1515.severity = none
# SA1402: varios convertidores/helpers pequeños en un único archivo (elección del proyecto).
dotnet_diagnostic.SA1402.severity = none