<UserControl x:Class="GestorSolicitudes.Views.CabeceraMetricas"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Tarjeta de métrica: valor grande y etiqueta pequeña debajo. -->
        <Style x:Key="ValorMetrica" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource Texto}" />
        </Style>

        <Style x:Key="TituloMetrica" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{StaticResource TextoSuave}" />
            <Setter Property="Margin" Value="0,1,0,0" />
        </Style>

        <Style x:Key="SeparadorMetrica" TargetType="{x:Type Border}">
            <Setter Property="Width" Value="1" />
            <Setter Property="Background" Value="{StaticResource Borde}" />
            <Setter Property="Margin" Value="20,4,20,4" />
        </Style>
    </UserControl.Resources>

    <!-- Contadores de la cabecera: enviadas, abiertas, en proceso, ofertas, tasa y media. -->
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel>
            <TextBlock Text="{Binding TotalSolicitudes}" Style="{StaticResource ValorMetrica}" />
            <TextBlock Text="{DynamicResource Metrica.Enviadas}" Style="{StaticResource TituloMetrica}" />
        </StackPanel>
        <Border Style="{StaticResource SeparadorMetrica}" />
        <StackPanel>
            <TextBlock Text="{Binding ProcesosAbiertos}" Style="{StaticResource ValorMetrica}" />
            <TextBlock Text="{DynamicResource Metrica.Abiertas}" Style="{StaticResource TituloMetrica}" />
        </StackPanel>
        <Border Style="{StaticResource SeparadorMetrica}" />
        <StackPanel>
            <TextBlock Text="{Binding EnEntrevista}" Style="{StaticResource ValorMetrica}" />
            <TextBlock Text="{DynamicResource Metrica.EnProceso}" Style="{StaticResource TituloMetrica}" />
        </StackPanel>
        <Border Style="{StaticResource SeparadorMetrica}" />
        <StackPanel>
            <TextBlock Text="{Binding OfertasRecibidas}" Style="{StaticResource ValorMetrica}" />
            <TextBlock Text="{DynamicResource Metrica.Ofertas}" Style="{StaticResource TituloMetrica}" />
        </StackPanel>
        <Border Style="{StaticResource SeparadorMetrica}" />
        <StackPanel>
            <TextBlock Text="{Binding TasaRespuesta}" Style="{StaticResource ValorMetrica}" />
            <TextBlock Text="{DynamicResource Metrica.TasaRespuesta}" Style="{StaticResource TituloMetrica}" />
        </StackPanel>
        <Border Style="{StaticResource SeparadorMetrica}" />
        <StackPanel>
            <TextBlock Text="{Binding MediaDiasRespuesta}" Style="{StaticResource ValorMetrica}" />
            <TextBlock Text="{DynamicResource Metrica.MediaRespuesta}" Style="{StaticResource TituloMetrica}" />
        </StackPanel>
    </StackPanel>
</UserControl>
