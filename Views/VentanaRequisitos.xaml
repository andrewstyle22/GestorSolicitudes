<Window x:Class="GestorSolicitudes.Views.VentanaRequisitos"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Requisitos del cargo"
        Height="520" Width="680"
        MinHeight="320" MinWidth="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResize"
        Background="{StaticResource Fondo}"
        FontFamily="Segoe UI"
        Foreground="{StaticResource Texto}">

    <DockPanel Margin="18">

        <!-- Botón de cierre -->
        <Border DockPanel.Dock="Bottom" Padding="0,14,0,0"
                BorderBrush="{StaticResource Borde}" BorderThickness="0,1,0,0">
            <Button Content="Cerrar" HorizontalAlignment="Right" MinWidth="90"
                    Style="{StaticResource BotonPrimario}"
                    IsCancel="True" Click="Cerrar_Click" />
        </Border>

        <!-- El texto, en grande y con scroll para leerlo con claridad -->
        <TextBox x:Name="TextoRequisitos"
                 IsReadOnly="True"
                 IsReadOnlyCaretVisible="True"
                 TextWrapping="Wrap"
                 AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Disabled"
                 FontSize="15"
                 FontFamily="Segoe UI"
                 Foreground="{StaticResource Texto}"
                 Background="{StaticResource Panel}"
                 BorderBrush="{StaticResource Borde}"
                 BorderThickness="1"
                 Padding="14,12" />
    </DockPanel>
</Window>