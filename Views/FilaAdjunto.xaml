<UserControl x:Class="GestorSolicitudes.Views.FilaAdjunto"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="raiz">
    <!-- Una fila de adjunto: CV y carta sólo cambian de etiqueta y de comandos. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0" FontWeight="SemiBold" VerticalAlignment="Center"
                   Text="{Binding Etiqueta, ElementName=raiz}" />

        <TextBlock Grid.Column="1" Margin="10,0,10,0" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"
                   ToolTip="{Binding Ruta, ElementName=raiz}"
                   Text="{Binding Texto, ElementName=raiz}" />

        <Button Grid.Column="2" Content="{DynamicResource Boton.Adjuntar}" Margin="0,0,6,0"
                Padding="10,4" FontSize="12" Style="{StaticResource BotonSecundario}"
                Command="{Binding ComandoAdjuntar, ElementName=raiz}" />
        <Button Grid.Column="3" Content="{DynamicResource Boton.Quitar}" Margin="0,0,6,0"
                Padding="10,4" FontSize="12" Style="{StaticResource BotonSecundario}"
                Command="{Binding ComandoQuitar, ElementName=raiz}" />
        <Button Grid.Column="4" Content="{DynamicResource Boton.Abrir}" Padding="10,4" FontSize="12"
                Style="{StaticResource BotonSecundario}" Click="Abrir_Click" />
    </Grid>
</UserControl>
