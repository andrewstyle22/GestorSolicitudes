<UserControl x:Class="GestorSolicitudes.Views.PestanaOferta"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Pestaña "Oferta" del panel de detalle. El DataContext es el ViewModel: los campos
         cuelgan de Edicion y los comandos, directos del ViewModel (sin RelativeSource). -->
    <ScrollViewer Margin="3,0,-12,0">
        <StackPanel>

            <TextBlock Text="{DynamicResource Oferta.EnlaceOferta}" Style="{StaticResource Etiqueta}" Margin="9,10,9,3" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Style="{StaticResource Campo}"
                         Text="{Binding Edicion.EnlaceOferta}" Margin="9,0,10,0" />
                <Button Grid.Column="1" Content="{DynamicResource Boton.Abrir}" Margin="0,0,6,0"
                        Style="{StaticResource BotonSecundario}"
                        Command="{Binding AbrirEnlaceCommand}" />
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{DynamicResource Oferta.PortalOrigen}" Style="{StaticResource Etiqueta}" Margin="9,10,0,3" />
                    <TextBox Style="{StaticResource Campo}" Text="{Binding Edicion.Portal}"
                             ToolTip="{DynamicResource Oferta.PortalToolTip}" Margin="9,0,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{DynamicResource Oferta.ViaContacto}" Style="{StaticResource Etiqueta}" Margin="0,10,9,3" />
                    <ComboBox Style="{StaticResource CampoCombo}"
                              ItemsSource="{Binding Origenes}"
                              DisplayMemberPath="Descripcion"
                              SelectedValuePath="Valor"
                              SelectedValue="{Binding Edicion.Origen}"
                              ToolTip="{DynamicResource Oferta.ViaContactoToolTip}" Width="182" Margin="0,0,9,0" />
                </StackPanel>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{DynamicResource Oferta.Ubicacion}" Style="{StaticResource Etiqueta}" Margin="9,10,0,3" />
                    <TextBox Style="{StaticResource Campo}" Text="{Binding Edicion.Ubicacion}" Margin="9,0,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{DynamicResource Oferta.Modalidad}" Style="{StaticResource Etiqueta}" Margin="0,10,9,3" />
                    <ComboBox Style="{StaticResource CampoCombo}"
                              ItemsSource="{Binding Modalidades}"
                              DisplayMemberPath="Descripcion"
                              SelectedValuePath="Valor"
                              SelectedValue="{Binding Edicion.Modalidad}" Width="182" Margin="0,0,9,0" />
                </StackPanel>
            </Grid>

            <TextBlock Text="{DynamicResource Oferta.Interes}" Style="{StaticResource Etiqueta}" Margin="9,10,9,3" />
            <ComboBox Style="{StaticResource CampoCombo}" HorizontalAlignment="Left" MinWidth="120"
                      ItemsSource="{Binding NivelesInteres}"
                      SelectedItem="{Binding Edicion.Interes}" Width="101" Margin="9,0,0,0" />

            <TextBlock Text="{DynamicResource Oferta.Tecnologias}" Style="{StaticResource Etiqueta}" Margin="9,10,9,3" />
            <TextBox Style="{StaticResource Campo}" Text="{Binding Edicion.Tecnologias}"
                     ToolTip="{DynamicResource Oferta.TecnologiasToolTip}" Margin="9,0,9,0" />

            <Grid Margin="9,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{DynamicResource Oferta.SalarioMin}" Style="{StaticResource Etiqueta}" Margin="9,10,0,3" />
                    <TextBox Style="{StaticResource Campo}"
                             Text="{Binding Edicion.SalarioMin, TargetNullValue=''}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{DynamicResource Oferta.SalarioMax}" Style="{StaticResource Etiqueta}" />
                    <TextBox Style="{StaticResource Campo}"
                             Text="{Binding Edicion.SalarioMax, TargetNullValue=''}" />
                </StackPanel>
                <StackPanel Grid.Column="4" Margin="9,0,9,0">
                    <TextBlock Text="{DynamicResource Oferta.Pretension}" Style="{StaticResource Etiqueta}" Margin="0,10,9,3" />
                    <TextBox Style="{StaticResource Campo}"
                             Text="{Binding Edicion.PretensionSalarial, TargetNullValue=''}" />
                </StackPanel>
            </Grid>

            <TextBlock Text="{DynamicResource Oferta.Requisitos}" Style="{StaticResource Etiqueta}" Margin="9,10,9,3" />
            <Grid Margin="7,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Style="{StaticResource CampoMultilinea}"
                         MinHeight="90"
                         Text="{Binding Edicion.Requisitos}"
                         ToolTip="{DynamicResource Oferta.RequisitosToolTip}" />
                <Button Grid.Column="1" Content="{DynamicResource Boton.Leer}" Margin="8,0,9,0"
                        Padding="12,8" VerticalAlignment="Center"
                        Style="{StaticResource BotonSecundario}"
                        Click="VerRequisitos_Click" />
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
