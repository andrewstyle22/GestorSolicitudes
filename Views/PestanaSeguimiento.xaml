<UserControl x:Class="GestorSolicitudes.Views.PestanaSeguimiento"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Pestaña "Seguimiento" del panel de detalle: estado, fechas, contacto y notas. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="9,0,8,0">
        <StackPanel>

            <TextBlock Text="{DynamicResource Seguimiento.EstadoActual}" Style="{StaticResource Etiqueta}" Margin="9,10,0,3" />
            <ComboBox Style="{StaticResource CampoCombo}"
                      ItemsSource="{Binding Estados}"
                      DisplayMemberPath="Descripcion"
                      SelectedValuePath="Valor"
                      SelectedValue="{Binding Editor.Estado}" Margin="9,0,9,0" />

            <StackPanel Visibility="{Binding Editor.Estado, Converter={StaticResource EstadoEsRechazadaAVisibilidad}}">
                <TextBlock Text="{DynamicResource Seguimiento.MotivoRechazo}" Style="{StaticResource Etiqueta}" Margin="9,10,9,3" />
                <ComboBox Style="{StaticResource CampoCombo}"
                          ItemsSource="{Binding MotivosRechazo}"
                          DisplayMemberPath="Descripcion"
                          SelectedValuePath="Valor"
                          SelectedValue="{Binding Editor.MotivoRechazo}" Margin="9,0,9,0" />
            </StackPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{DynamicResource Seguimiento.FechaSolicitud}" Style="{StaticResource Etiqueta}" Margin="9,10,0,3" />
                    <DatePicker Style="{StaticResource CampoFecha}"
                                SelectedDate="{Binding Edicion.FechaSolicitud}" Margin="9,0,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{DynamicResource Seguimiento.PrimeraContestacion}" Style="{StaticResource Etiqueta}" Margin="0,10,9,3" />
                    <DatePicker Style="{StaticResource CampoFecha}"
                                SelectedDate="{Binding Edicion.FechaPrimeraRespuesta}" Margin="0,0,9,0" />
                </StackPanel>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{DynamicResource Seguimiento.DiaEntrevista}" Style="{StaticResource Etiqueta}" Margin="9,10,0,3" />
                    <DatePicker Style="{StaticResource CampoFecha}"
                                SelectedDate="{Binding Edicion.FechaEntrevista}" Margin="9,0,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{DynamicResource Seguimiento.ProximoSeguimiento}" Style="{StaticResource Etiqueta}" Margin="0,10,8,3" />
                    <DatePicker Style="{StaticResource CampoFecha}"
                                SelectedDate="{Binding Edicion.ProximoSeguimiento}"
                                ToolTip="{DynamicResource Seguimiento.ProximoSeguimientoToolTip}" Margin="0,0,9,0" />
                </StackPanel>
            </Grid>

            <TextBlock Text="{DynamicResource Seguimiento.FechaCierre}" Style="{StaticResource Etiqueta}" Margin="9,10,9,3" />
            <DatePicker Style="{StaticResource CampoFecha}"
                        SelectedDate="{Binding Edicion.FechaCierre}" Margin="9,0,9,0" />

            <TextBlock Text="{DynamicResource Seguimiento.RespuestaEmpresa}" Style="{StaticResource Etiqueta}" Margin="9,10,9,3" />
            <TextBox Style="{StaticResource CampoMultilinea}"
                     Text="{Binding Edicion.RespuestaEmpresa}" Margin="9,0,9,0" />

            <TextBlock Text="{DynamicResource Seguimiento.Contacto}" Style="{StaticResource TituloSeccion}" Margin="9,18,9,2" />

            <Grid Margin="9,0,9,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{DynamicResource Campo.Nombre}" Style="{StaticResource Etiqueta}" />
                    <TextBox Style="{StaticResource Campo}" Text="{Binding Edicion.ContactoNombre}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{DynamicResource Campo.Email}" Style="{StaticResource Etiqueta}" />
                    <TextBox Style="{StaticResource Campo}" Text="{Binding Edicion.ContactoEmail}" />
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="{DynamicResource Campo.Telefono}" Style="{StaticResource Etiqueta}" />
                    <TextBox Style="{StaticResource Campo}" Text="{Binding Edicion.ContactoTelefono}" />
                </StackPanel>
            </Grid>

            <TextBlock Text="{DynamicResource Campo.Notas}" Style="{StaticResource Etiqueta}" Margin="9,10,9,3" />
            <TextBox Style="{StaticResource CampoMultilinea}" Text="{Binding Edicion.Notas}" Margin="9,0,9,0" />

        </StackPanel>
    </ScrollViewer>
</UserControl>
