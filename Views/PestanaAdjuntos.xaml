<UserControl x:Class="GestorSolicitudes.Views.PestanaAdjuntos"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:GestorSolicitudes.Views">
    <!-- Pestaña "Adjuntos e historial" del panel de detalle. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <TextBlock Text="{DynamicResource Adjuntos.Titulo}" Style="{StaticResource TituloSeccion}" Margin="9,18,9,2" />
            <TextBlock Text="{DynamicResource Adjuntos.Texto}"
                       FontSize="11" Foreground="{StaticResource TextoSuave}" Margin="9,0,9,0" />

            <Border BorderBrush="{StaticResource Borde}" BorderThickness="1"
                    CornerRadius="6" Padding="10" Margin="9,8,9,0">
                <StackPanel>
                    <views:FilaAdjunto Margin="0,2,0,8"
                                       Etiqueta="{DynamicResource Adjuntos.Curriculum}"
                                       Adjunto="{Binding AdjuntoCv}"
                                       ComandoAdjuntar="{Binding AdjuntarCvCommand}"
                                       ComandoQuitar="{Binding QuitarCvCommand}"
                                       ComandoAbrir="{Binding AbrirAdjuntoCommand}" />

                    <views:FilaAdjunto Etiqueta="{DynamicResource Adjuntos.Carta}"
                                       Adjunto="{Binding AdjuntoCarta}"
                                       ComandoAdjuntar="{Binding AdjuntarCartaCommand}"
                                       ComandoQuitar="{Binding QuitarCartaCommand}"
                                       ComandoAbrir="{Binding AbrirAdjuntoCommand}" />
                </StackPanel>
            </Border>

            <!-- Historial -->
            <Grid Margin="0,18,0,2">
                <TextBlock Text="{DynamicResource Historial.Titulo}" Style="{StaticResource TituloSeccion}"
                           Margin="9,0,0,0" VerticalAlignment="Center" />
                <Button Content="{DynamicResource Historial.Anadir}" HorizontalAlignment="Right"
                        Padding="10,4" FontSize="12"
                        Style="{StaticResource BotonSecundario}"
                        Command="{Binding AnadirEventoCommand}" Margin="0,0,9,0" />
            </Grid>

            <ItemsControl ItemsSource="{Binding EventosEdicion}" Margin="9,6,9,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{StaticResource Borde}" BorderThickness="1"
                                CornerRadius="6" Padding="8" Margin="0,0,0,6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <DatePicker Grid.Row="0" Grid.Column="0" Width="120"
                                            FontSize="12"
                                            SelectedDate="{Binding Fecha}" />

                                <!-- Dentro de la plantilla el DataContext es el evento: los
                                     comandos y la lista de tipos están en el ViewModel. -->
                                <ComboBox Grid.Row="0" Grid.Column="1" Margin="6,0,0,0"
                                          FontSize="12"
                                          ItemsSource="{Binding DataContext.TiposEvento, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                          DisplayMemberPath="Descripcion"
                                          SelectedValuePath="Valor"
                                          SelectedValue="{Binding Tipo}" />

                                <Button Grid.Row="0" Grid.Column="2" Content="✕"
                                        Margin="6,0,0,0" Padding="8,3" FontSize="12"
                                        Style="{StaticResource BotonPeligro}"
                                        ToolTip="{DynamicResource Boton.Eliminar}"
                                        AutomationProperties.Name="{DynamicResource Boton.Eliminar}"
                                        Command="{Binding DataContext.EliminarEventoCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                        CommandParameter="{Binding}" />

                                <TextBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                         Margin="0,6,0,0" FontSize="12"
                                         Style="{StaticResource Campo}"
                                         Text="{Binding Descripcion}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
