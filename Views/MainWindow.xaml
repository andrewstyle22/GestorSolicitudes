<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tb="clr-namespace:Hardcodet.Wpf.TaskbarNotification;assembly=Hardcodet.NotifyIcon.Wpf"
        xmlns:loc="clr-namespace:GestorSolicitudes"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" x:Class="GestorSolicitudes.Views.MainWindow"
        Icon="/GestorSolicitudes;component/Resources/appicon.ico"
        Title="{DynamicResource TituloVentana}"
        Height="780" Width="1500"
        MinHeight="600" MinWidth="1080"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        >

    <Window.Resources>

        <!-- Tarjeta de métrica de la cabecera -->
        <Style x:Key="ValorMetrica" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource Texto}" />
        </Style>

        <Style x:Key="TituloMetrica" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{StaticResource TextoSuave}" />
            <Setter Property="Margin" Value="0,1,0,0" />
        </Style>

        <Style x:Key="SeparadorMetrica" TargetType="{x:Type Border}">
            <Setter Property="Width" Value="1" />
            <Setter Property="Background" Value="{StaticResource Borde}" />
            <Setter Property="Margin" Value="20,4,20,4" />
        </Style>

    </Window.Resources>

    <Window.Background>
        <StaticResource ResourceKey="Fondo"/>
    </Window.Background>
    <Window.Foreground>
        <StaticResource ResourceKey="Texto"/>
    </Window.Foreground>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===================== CABECERA ===================== -->
        <Border Grid.Row="0" Background="{StaticResource Panel}"
                BorderBrush="{StaticResource Borde}" BorderThickness="0,0,0,1"
                Padding="20,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource TituloVentana}" FontSize="18" FontWeight="Bold" />
                    <TextBlock Text="{DynamicResource SubtituloVentana}"
                               FontSize="12" Foreground="{StaticResource TextoSuave}" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="{Binding TotalSolicitudes}" Style="{StaticResource ValorMetrica}" />
                        <TextBlock Text="{DynamicResource Metrica.Enviadas}" Style="{StaticResource TituloMetrica}" />
                    </StackPanel>
                    <Border Style="{StaticResource SeparadorMetrica}" />
                    <StackPanel>
                        <TextBlock Text="{Binding ProcesosAbiertos}" Style="{StaticResource ValorMetrica}" />
                        <TextBlock Text="{DynamicResource Metrica.Abiertas}" Style="{StaticResource TituloMetrica}" />
                    </StackPanel>
                    <Border Style="{StaticResource SeparadorMetrica}" />
                    <StackPanel>
                        <TextBlock Text="{Binding EnEntrevista}" Style="{StaticResource ValorMetrica}" />
                        <TextBlock Text="{DynamicResource Metrica.EnProceso}" Style="{StaticResource TituloMetrica}" />
                    </StackPanel>
                    <Border Style="{StaticResource SeparadorMetrica}" />
                    <StackPanel>
                        <TextBlock Text="{Binding OfertasRecibidas}" Style="{StaticResource ValorMetrica}" />
                        <TextBlock Text="{DynamicResource Metrica.Ofertas}" Style="{StaticResource TituloMetrica}" />
                    </StackPanel>
                    <Border Style="{StaticResource SeparadorMetrica}" />
                    <StackPanel>
                        <TextBlock Text="{Binding TasaRespuesta}" Style="{StaticResource ValorMetrica}" />
                        <TextBlock Text="{DynamicResource Metrica.TasaRespuesta}" Style="{StaticResource TituloMetrica}" />
                    </StackPanel>
                    <Border Style="{StaticResource SeparadorMetrica}" />
                    <StackPanel>
                        <TextBlock Text="{Binding MediaDiasRespuesta}" Style="{StaticResource ValorMetrica}" />
                        <TextBlock Text="{DynamicResource Metrica.MediaRespuesta}" Style="{StaticResource TituloMetrica}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

                    <!-- Selector de idioma con banderas dibujadas en XAML -->
                    <ComboBox ItemsSource="{Binding IdiomasDisponibles}"
                              SelectedValuePath="Idioma"
                              SelectedValue="{Binding IdiomaActual}"
                              ToolTip="{DynamicResource Selector.ToolTip}"
                              Width="64" Margin="0,0,10,0"
                              Height="{Binding ActualHeight, ElementName=BotonGrafica}"
                              Padding="0"
                              HorizontalContentAlignment="Stretch"
                              VerticalContentAlignment="Stretch"
                              Style="{StaticResource CampoCombo}">
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Left" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                            </Style>
                        </ComboBox.ItemContainerStyle>
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Border MinWidth="26" MinHeight="17" CornerRadius="2"
                                            BorderBrush="#8FA3B8" BorderThickness="1"
                                            ClipToBounds="True">
                                        <Grid>
                                            <Grid x:Name="BanderaInglaterra" Background="White">
                                                <Rectangle Fill="#CE1126" Height="4" VerticalAlignment="Center" />
                                                <Rectangle Fill="#CE1126" Width="4" HorizontalAlignment="Center" />
                                            </Grid>
                                            <Grid x:Name="BanderaAlemania" Visibility="Collapsed">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>
                                                <Rectangle Grid.Row="0" Fill="#000000" />
                                                <Rectangle Grid.Row="1" Fill="#DD0000" />
                                                <Rectangle Grid.Row="2" Fill="#FFCE00" />
                                            </Grid>
                                            <Grid x:Name="BanderaEspana" Visibility="Collapsed">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>
                                                <Rectangle Grid.Row="0" Fill="#AA151B" />
                                                <Rectangle Grid.Row="1" Fill="#F1BF00" />
                                                <Rectangle Grid.Row="2" Fill="#AA151B" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Idioma}" Value="{x:Static loc:Idioma.Castellano}">
                                        <Setter TargetName="BanderaInglaterra" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="BanderaEspana" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Idioma}" Value="{x:Static loc:Idioma.Aleman}">
                                        <Setter TargetName="BanderaInglaterra" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="BanderaAlemania" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Button x:Name="BotonGrafica"
                            Content="{Binding VerGrafica, Converter={StaticResource VerGraficaATexto}}"
                            Style="{StaticResource BotonSecundario}"
                            Command="{Binding ConfigurarGraficaCommand}" Margin="0,0,8,0" />
                    <Button Content="{DynamicResource Boton.ImportarLinkedIn}" Style="{StaticResource BotonSecundario}"
                            Command="{Binding ImportarLinkedInCommand}" Margin="0,0,8,0" />
                    <Button Content="{DynamicResource Boton.ExportarCsv}" Style="{StaticResource BotonSecundario}"
                            Command="{Binding ExportarCsvCommand}" Margin="0,0,8,0" />
                    <Button Content="{DynamicResource Boton.NuevaCandidatura}" Style="{StaticResource BotonPrimario}"
                            Command="{Binding NuevaCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===================== GRÁFICA DE EMBUDO ===================== -->
        <Border Grid.Row="1" Margin="16,12,16,0" Padding="16,12"
                Background="{StaticResource Panel}"
                BorderBrush="{StaticResource Borde}" BorderThickness="1" CornerRadius="8"
                Visibility="{Binding VerGrafica, Converter={StaticResource BooleanoAVisibilidad}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <TextBlock Text="{DynamicResource Grafica.Titulo}"
                               Style="{StaticResource TituloSeccion}" Margin="0" VerticalAlignment="Center" />
                    <Button Content="{Binding VerGrafica, Converter={StaticResource VerGraficaATexto}}"
                            HorizontalAlignment="Right" Padding="10,5" FontSize="12"
                            Style="{StaticResource BotonSecundario}"
                            Command="{Binding ConfigurarGraficaCommand}" />
                </Grid>

                <!-- Leyenda -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                        <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="#94A3B8" Margin="0,0,4,0" VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource Grafica.Enviadas}" FontSize="11" Foreground="{StaticResource TextoSuave}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                        <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="#2563EB" Margin="0,0,4,0" VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource Grafica.Respondidas}" FontSize="11" Foreground="{StaticResource TextoSuave}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                        <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="#7C3AED" Margin="0,0,4,0" VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource Grafica.Entrevistas}" FontSize="11" Foreground="{StaticResource TextoSuave}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="#059669" Margin="0,0,4,0" VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource Grafica.Ofertas}" FontSize="11" Foreground="{StaticResource TextoSuave}" />
                    </StackPanel>
                </StackPanel>

                <ScrollViewer Grid.Row="2" Margin="0,10,0,0" VerticalAlignment="Bottom"
                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding MesesEmbudo}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="96" Margin="0,0,4,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Height="180">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="0">
                                            <Border Width="14" Height="{Binding AlturaEnviadas}"
                                                    Background="#94A3B8" CornerRadius="2"
                                                    HorizontalAlignment="Center" VerticalAlignment="Bottom" />
                                            <TextBlock Text="{Binding Enviadas}" FontSize="9"
                                                       Foreground="{StaticResource TextoSuave}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Top" />
                                        </Grid>
                                        <Grid Grid.Column="1">
                                            <Border Width="14" Height="{Binding AlturaRespondidas}"
                                                    Background="#2563EB" CornerRadius="2"
                                                    HorizontalAlignment="Center" VerticalAlignment="Bottom" />
                                            <TextBlock Text="{Binding Respondidas}" FontSize="9"
                                                       Foreground="{StaticResource TextoSuave}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Top" />
                                        </Grid>
                                        <Grid Grid.Column="2">
                                            <Border Width="14" Height="{Binding AlturaEntrevistas}"
                                                    Background="#7C3AED" CornerRadius="2"
                                                    HorizontalAlignment="Center" VerticalAlignment="Bottom" />
                                            <TextBlock Text="{Binding Entrevistas}" FontSize="9"
                                                       Foreground="{StaticResource TextoSuave}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Top" />
                                        </Grid>
                                        <Grid Grid.Column="3">
                                            <Border Width="14" Height="{Binding AlturaOfertas}"
                                                    Background="#059669" CornerRadius="2"
                                                    HorizontalAlignment="Center" VerticalAlignment="Bottom" />
                                            <TextBlock Text="{Binding Ofertas}" FontSize="9"
                                                       Foreground="{StaticResource TextoSuave}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Top" />
                                        </Grid>
                                    </Grid>
                                    <TextBlock Grid.Row="1" Text="{Binding Etiqueta}" Margin="0,4,0,0"
                                               FontSize="10" Foreground="{StaticResource TextoSuave}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ===================== CUERPO ===================== -->
        <Grid Grid.Row="2" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="394*" MinWidth="520" />
                <ColumnDefinition Width="75*"/>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Lista -->
            <Border Grid.Column="0" Background="{StaticResource Panel}"
                    BorderBrush="{StaticResource Borde}" BorderThickness="1" CornerRadius="8" Grid.ColumnSpan="2">
                <Grid x:Name="TablaCandidaturas">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Filtros -->
                    <Grid Grid.Row="0" Margin="14,14,14,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="Buscar_empresas" Grid.Column="0" Style="{StaticResource Campo}"
                                     Text="{Binding TextoBusqueda, Delay=250, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="{DynamicResource Filtro.BuscarToolTip}" />
                            <Button Grid.Column="1" Content="✕" Margin="6,0,0,0"
                                    Padding="9,2" VerticalAlignment="Center"
                                    Style="{StaticResource BotonSecundario}"
                                    ToolTip="{DynamicResource Filtro.BorrarBusqueda}"
                                    Command="{Binding LimpiarBusquedaCommand}" />
                        </Grid>

                        <ComboBox Grid.Column="1" Width="190" Margin="8,0,0,0"
                                  Style="{StaticResource CampoCombo}"
                                  ItemsSource="{Binding EstadosFiltro}"
                                  DisplayMemberPath="Descripcion"
                                  SelectedItem="{Binding EstadoFiltroItem}" />

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="12,0,0,0"
                                    VerticalAlignment="Center">
                            <CheckBox Content="{DynamicResource Filtro.SoloAbiertas}" VerticalAlignment="Center"
                                      IsChecked="{Binding SoloAbiertas}" />
                            <CheckBox Content="{DynamicResource Filtro.SeguimientoPendiente}" VerticalAlignment="Center"
                                      Margin="12,0,0,0"
                                      IsChecked="{Binding SoloConSeguimientoPendiente}" />
                        </StackPanel>
                    </Grid>

                    <!-- Tabla -->
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Solicitudes}"
                              SelectedItem="{Binding SolicitudSeleccionada, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Single"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{StaticResource Borde}"
                              BorderThickness="0"
                              RowHeight="38"
                              FontSize="13"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Visible">

                        <DataGrid.RowStyle>
                            <Style TargetType="{x:Type DataGridRow}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SeguimientoPendiente}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource Aviso}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding EstaAbierta}" Value="False">
                                        <Setter Property="Foreground" Value="{StaticResource TextoSuave}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.Columns>
                            <DataGridTextColumn x:Name="Empresa" Binding="{Binding Empresa}" Width="260" MinWidth="260">
                                <DataGridTextColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{DynamicResource Columna.Empresa}" />
                                    </DataTemplate>
                                </DataGridTextColumn.HeaderTemplate>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="Margin" Value="10,0,0,0" />
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn x:Name="Puesto" Binding="{Binding Puesto}" Width="300" MinWidth="300">
                                <DataGridTextColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{DynamicResource Columna.Puesto}" />
                                    </DataTemplate>
                                </DataGridTextColumn.HeaderTemplate>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="Margin" Value="6,0,0,0" />
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTemplateColumn x:Name="Estado" Width="150">
                                <DataGridTemplateColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{DynamicResource Columna.Estado}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.HeaderTemplate>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="10" Padding="8,3"
                                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                                Margin="4,0,0,0"
                                                Background="{Binding Estado, Converter={StaticResource EstadoAColor}}">
                                            <TextBlock Text="{Binding Estado, Converter={StaticResource EnumDescripcion}}"
                                                       Foreground="White" FontSize="11" FontWeight="SemiBold" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn x:Name="Enviadas" Binding="{Binding FechaSolicitud, StringFormat=dd/MM/yyyy}"
                                                Width="100">
                                <DataGridTextColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{DynamicResource Columna.Enviada}" />
                                    </DataTemplate>
                                </DataGridTextColumn.HeaderTemplate>
                            </DataGridTextColumn>

                            <DataGridTextColumn x:Name="Dias" Binding="{Binding DiasProceso}" Width="60">
                                <DataGridTextColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{DynamicResource Columna.Dias}" />
                                    </DataTemplate>
                                </DataGridTextColumn.HeaderTemplate>
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="{x:Type DataGridColumnHeader}">
                                        <Setter Property="ToolTip"
                                                Value="{DynamicResource Columna.DiasToolTip}" />
                                    </Style>
                                </DataGridTextColumn.HeaderStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn x:Name="Primera_respuesta" Binding="{Binding FechaPrimeraRespuesta, StringFormat=dd/MM/yyyy}"
                                                Width="110">
                                <DataGridTextColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{DynamicResource Columna.PrimeraRespuesta}" />
                                    </DataTemplate>
                                </DataGridTextColumn.HeaderTemplate>
                            </DataGridTextColumn>

                            <DataGridTextColumn x:Name="Entrevista" Binding="{Binding FechaEntrevista, StringFormat=dd/MM/yyyy}"
                                                Width="105">
                                <DataGridTextColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{DynamicResource Columna.Entrevista}" />
                                    </DataTemplate>
                                </DataGridTextColumn.HeaderTemplate>
                            </DataGridTextColumn>

                            <DataGridTextColumn x:Name="Seguimiento" Binding="{Binding ProximoSeguimiento, StringFormat=dd/MM/yyyy}"
                                                Width="105">
                                <DataGridTextColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{DynamicResource Columna.Seguimiento}" />
                                    </DataTemplate>
                                </DataGridTextColumn.HeaderTemplate>
                            </DataGridTextColumn>

                            <DataGridTextColumn x:Name="Interes" Binding="{Binding Interes, Converter={StaticResource InteresATextoEstrellas}}"
                                                Width="90">
                                <DataGridTextColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{DynamicResource Columna.Interes}" />
                                    </DataTemplate>
                                </DataGridTextColumn.HeaderTemplate>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Foreground" Value="{StaticResource Estrella}" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn x:Name="Portal" Binding="{Binding Portal}" Width="150" MinWidth="170">
                                <DataGridTextColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{DynamicResource Columna.Portal}" />
                                    </DataTemplate>
                                </DataGridTextColumn.HeaderTemplate>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="2" Width="8" HorizontalAlignment="Stretch"
                          Background="Transparent"
                          Visibility="{Binding Edicion, Converter={StaticResource NuloAVisibilidad}}" />

            <!-- Detalle -->
            <Border x:Name="NuevaCandidatura" Grid.Column="3" Background="{StaticResource Panel}"
                    BorderBrush="{StaticResource Borde}" BorderThickness="1" CornerRadius="8"
                    Width="440" MinWidth="380"
                    Visibility="{Binding Edicion, Converter={StaticResource NuloAVisibilidad}}">
                <Grid>

                    <!-- Formulario -->
                    <Grid Visibility="{Binding Edicion, Converter={StaticResource NuloAVisibilidad}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Cabecera fija: lo mínimo que siempre debe verse -->
                        <StackPanel Grid.Row="0" DataContext="{Binding Edicion}" Margin="18,14,18,10">

                            <TextBlock Text="{DynamicResource Detalle.Empresa}" Style="{StaticResource Etiqueta}" Margin="9,10,9,3" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Style="{StaticResource Campo}" Text="{Binding Empresa}" Margin="9,0,0,0" />
                                <Button Grid.Column="1" Content="{DynamicResource Detalle.VerTodas}" Margin="6,0,9,0"
                                        Style="{StaticResource BotonSecundario}"
                                        ToolTip="{DynamicResource Detalle.VerTodasToolTip}"
                                        Command="{Binding DataContext.VerCandidaturasDeEstaEmpresaCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                            </Grid>

                            <TextBlock Text="{DynamicResource Detalle.Puesto}" Style="{StaticResource Etiqueta}" Margin="9,10,9,3" />
                            <TextBox Style="{StaticResource Campo}" Text="{Binding Puesto}" Margin="9,0,10,0" />
                        </StackPanel>

                        <!-- Pestañas: Oferta / Seguimiento / Adjuntos e historial -->
                        <TabControl Grid.Row="1" Style="{StaticResource Pestanas}" Height="355" VerticalAlignment="Top">

                            <TabItem Header="{DynamicResource Pestana.Oferta}" Style="{StaticResource Pestana}">
                                <ScrollViewer Margin="3,0,-12,0" Cursor="">
                                    <StackPanel DataContext="{Binding Edicion}">

                                        <TextBlock Text="{DynamicResource Oferta.EnlaceOferta}" Style="{StaticResource Etiqueta}" Margin="9,10,9,3" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Style="{StaticResource Campo}"
                                                     Text="{Binding EnlaceOferta}" Margin="9,0,10,0" />
                                            <Button Grid.Column="1" Content="{DynamicResource Boton.Abrir}" Margin="0,0,6,0"
                                                    Style="{StaticResource BotonSecundario}"
                                                    Command="{Binding DataContext.AbrirEnlaceCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                                        </Grid>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{DynamicResource Oferta.PortalOrigen}" Style="{StaticResource Etiqueta}" Margin="9,10,0,3" />
                                                <TextBox Style="{StaticResource Campo}" Text="{Binding Portal}"
                                                         ToolTip="{DynamicResource Oferta.PortalToolTip}" Margin="9,0,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="{DynamicResource Oferta.ViaContacto}" Style="{StaticResource Etiqueta}" Margin="0,10,9,3" />
                                                <ComboBox Style="{StaticResource CampoCombo}"
                                                          ItemsSource="{Binding DataContext.Origenes, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                          DisplayMemberPath="Descripcion"
                                                          SelectedValuePath="Valor"
                                                          SelectedValue="{Binding Origen}"
                                                          ToolTip="{DynamicResource Oferta.ViaContactoToolTip}" Width="182" Margin="0,0,9,0" />
                                            </StackPanel>
                                        </Grid>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{DynamicResource Oferta.Ubicacion}" Style="{StaticResource Etiqueta}" Margin="9,10,0,3" />
                                                <TextBox Style="{StaticResource Campo}" Text="{Binding Ubicacion}" Margin="9,0,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="{DynamicResource Oferta.Modalidad}" Style="{StaticResource Etiqueta}" Margin="0,10,9,3" />
                                                <ComboBox Style="{StaticResource CampoCombo}"
                                                          ItemsSource="{Binding DataContext.Modalidades, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                          DisplayMemberPath="Descripcion"
                                                          SelectedValuePath="Valor"
                                                          SelectedValue="{Binding Modalidad}" Width="182" Margin="0,0,9,0" />
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="{DynamicResource Oferta.Interes}" Style="{StaticResource Etiqueta}" Margin="9,10,9,3" />
                                        <ComboBox Style="{StaticResource CampoCombo}" HorizontalAlignment="Left" MinWidth="120"
                                                  ItemsSource="{Binding DataContext.NivelesInteres, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                  SelectedItem="{Binding Interes}" Width="101" Margin="9,0,0,0" />

                                        <TextBlock Text="{DynamicResource Oferta.Tecnologias}" Style="{StaticResource Etiqueta}" Margin="9,10,9,3" />
                                        <TextBox Style="{StaticResource Campo}" Text="{Binding Tecnologias}"
                                                 ToolTip="{DynamicResource Oferta.TecnologiasToolTip}" Margin="9,0,9,0" />

                                        <Grid Margin="9,0,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{DynamicResource Oferta.SalarioMin}" Style="{StaticResource Etiqueta}" Margin="9,10,0,3" />
                                                <TextBox Style="{StaticResource Campo}"
                                                         Text="{Binding SalarioMin, TargetNullValue=''}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="{DynamicResource Oferta.SalarioMax}" Style="{StaticResource Etiqueta}" />
                                                <TextBox Style="{StaticResource Campo}"
                                                         Text="{Binding SalarioMax, TargetNullValue=''}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="4" Margin="9,0,9,0">
                                                <TextBlock Text="{DynamicResource Oferta.Pretension}" Style="{StaticResource Etiqueta}" Margin="0,10,9,3" />
                                                <TextBox Style="{StaticResource Campo}"
                                                         Text="{Binding PretensionSalarial, TargetNullValue=''}" />
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="{DynamicResource Oferta.Requisitos}" Style="{StaticResource Etiqueta}" Margin="9,10,9,3" />
                                        <Grid Margin="7,0,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Style="{StaticResource CampoMultilinea}"
                                                     MinHeight="90"
                                                     Text="{Binding Requisitos}"
                                                     ToolTip="{DynamicResource Oferta.RequisitosToolTip}" />
                                            <Button Grid.Column="1" Content="{DynamicResource Boton.Leer}" Margin="8,0,9,0"
                                                    Padding="12,8" VerticalAlignment="Center"
                                                    Style="{StaticResource BotonSecundario}"
                                                    Click="VerRequisitos_Click" />
                                        </Grid>

                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>

                            <TabItem Header="{DynamicResource Pestana.Seguimiento}" Style="{StaticResource Pestana}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="9,0,8,0">
                                    <StackPanel DataContext="{Binding Edicion}">

                                        <TextBlock Text="{DynamicResource Seguimiento.EstadoActual}" Style="{StaticResource Etiqueta}" Margin="9,10,0,3" />
                                        <ComboBox Style="{StaticResource CampoCombo}"
                                                  ItemsSource="{Binding DataContext.Estados, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                  DisplayMemberPath="Descripcion"
                                                  SelectedValuePath="Valor"
                                                  SelectedValue="{Binding Estado}" Margin="9,0,9,0" />

                                        <StackPanel Visibility="{Binding Estado, Converter={StaticResource EstadoEsRechazadaAVisibilidad}}">
                                            <TextBlock Text="{DynamicResource Seguimiento.MotivoRechazo}" Style="{StaticResource Etiqueta}" Margin="9,10,9,3" />
                                            <ComboBox Style="{StaticResource CampoCombo}"
                                                      ItemsSource="{Binding DataContext.MotivosRechazo, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                      DisplayMemberPath="Descripcion"
                                                      SelectedValuePath="Valor"
                                                      SelectedValue="{Binding MotivoRechazo}" Margin="9,0,9,0" />
                                        </StackPanel>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{DynamicResource Seguimiento.FechaSolicitud}" Style="{StaticResource Etiqueta}" Margin="9,10,0,3" />
                                                <DatePicker Style="{StaticResource CampoFecha}"
                                                            SelectedDate="{Binding FechaSolicitud}" Margin="9,0,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="{DynamicResource Seguimiento.PrimeraContestacion}" Style="{StaticResource Etiqueta}" Margin="0,10,9,3" />
                                                <DatePicker Style="{StaticResource CampoFecha}"
                                                            SelectedDate="{Binding FechaPrimeraRespuesta}" Margin="0,0,9,0" />
                                            </StackPanel>
                                        </Grid>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{DynamicResource Seguimiento.DiaEntrevista}" Style="{StaticResource Etiqueta}" Margin="9,10,0,3" />
                                                <DatePicker Style="{StaticResource CampoFecha}"
                                                            SelectedDate="{Binding FechaEntrevista}" Margin="9,0,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="{DynamicResource Seguimiento.ProximoSeguimiento}" Style="{StaticResource Etiqueta}" Margin="0,10,8,3" />
                                                <DatePicker Style="{StaticResource CampoFecha}"
                                                            SelectedDate="{Binding ProximoSeguimiento}"
                                                            ToolTip="{DynamicResource Seguimiento.ProximoSeguimientoToolTip}" Margin="0,0,9,0" />
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="{DynamicResource Seguimiento.FechaCierre}" Style="{StaticResource Etiqueta}" Margin="9,10,9,3" />
                                        <DatePicker Style="{StaticResource CampoFecha}"
                                                    SelectedDate="{Binding FechaCierre}" Margin="9,0,9,0" />

                                        <TextBlock Text="{DynamicResource Seguimiento.RespuestaEmpresa}" Style="{StaticResource Etiqueta}" Margin="9,10,9,3" />
                                        <TextBox Style="{StaticResource CampoMultilinea}"
                                                 Text="{Binding RespuestaEmpresa}" Margin="9,0,9,0" />

                                        <TextBlock Text="{DynamicResource Seguimiento.Contacto}" Style="{StaticResource TituloSeccion}" Margin="9,18,9,2" />

                                        <Grid Margin="9,0,9,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{DynamicResource Campo.Nombre}" Style="{StaticResource Etiqueta}" />
                                                <TextBox Style="{StaticResource Campo}" Text="{Binding ContactoNombre}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="{DynamicResource Campo.Email}" Style="{StaticResource Etiqueta}" />
                                                <TextBox Style="{StaticResource Campo}" Text="{Binding ContactoEmail}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="4">
                                                <TextBlock Text="{DynamicResource Campo.Telefono}" Style="{StaticResource Etiqueta}" />
                                                <TextBox Style="{StaticResource Campo}" Text="{Binding ContactoTelefono}" />
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="{DynamicResource Campo.Notas}" Style="{StaticResource Etiqueta}" Margin="9,10,9,3" />
                                        <TextBox Style="{StaticResource CampoMultilinea}" Text="{Binding Notas}" Margin="9,0,9,0" />

                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>

                            <TabItem Header="{DynamicResource Pestana.AdjuntosHistorial}" Style="{StaticResource Pestana}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel DataContext="{Binding Edicion}">

                                        <TextBlock Text="{DynamicResource Adjuntos.Titulo}" Style="{StaticResource TituloSeccion}" Margin="9,18,9,2" />
                                        <TextBlock Text="{DynamicResource Adjuntos.Texto}"
                                                   FontSize="11" Foreground="{StaticResource TextoSuave}" Margin="9,0,9,0" />

                                        <Border BorderBrush="{StaticResource Borde}" BorderThickness="1"
                                                CornerRadius="6" Padding="10" Margin="9,8,9,0">
                                            <StackPanel>
                                                <Grid Margin="0,2,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{DynamicResource Adjuntos.Curriculum}" FontWeight="SemiBold"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Margin="10,0,10,0" VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding RutaCv}"
                                                               Text="{Binding NombreCv, ConverterParameter=Adjuntos.SinAdjuntar, Converter={StaticResource NuloACadena}}" />
                                                    <Button Grid.Column="2" Content="{DynamicResource Boton.Adjuntar}" Margin="0,0,6,0"
                                                            Padding="10,4" FontSize="12"
                                                            Style="{StaticResource BotonSecundario}"
                                                            Command="{Binding DataContext.AdjuntarCvCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                                                    <Button Grid.Column="3" Content="{DynamicResource Boton.Quitar}" Margin="0,0,6,0"
                                                            Padding="10,4" FontSize="12"
                                                            Style="{StaticResource BotonSecundario}"
                                                            Command="{Binding DataContext.QuitarCvCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                                                    <Button Grid.Column="4" Content="{DynamicResource Boton.Abrir}" Padding="10,4" FontSize="12"
                                                            Style="{StaticResource BotonSecundario}"
                                                            Command="{Binding DataContext.AbrirCvCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                                                </Grid>

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="32*" />
                                                        <ColumnDefinition Width="85*"/>
                                                        <ColumnDefinition Width="167*"/>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{DynamicResource Adjuntos.Carta}" FontWeight="SemiBold"
                                                               VerticalAlignment="Center" Grid.ColumnSpan="2" Margin="0,0,32,0" />
                                                    <TextBlock Grid.Column="1" Margin="0,0,10,0" VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding RutaCarta}"
                                                               Text="{Binding NombreCarta, ConverterParameter=Adjuntos.SinAdjuntar, Converter={StaticResource NuloACadena}}" Grid.ColumnSpan="3" />
                                                    <Button Grid.Column="4" Content="{DynamicResource Boton.Adjuntar}" Margin="0,0,6,0"
                                                            Padding="10,4" FontSize="12"
                                                            Style="{StaticResource BotonSecundario}"
                                                            Command="{Binding DataContext.AdjuntarCartaCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                                                    <Button Grid.Column="5" Content="{DynamicResource Boton.Quitar}" Margin="0,0,6,0"
                                                            Padding="10,4" FontSize="12"
                                                            Style="{StaticResource BotonSecundario}"
                                                            Command="{Binding DataContext.QuitarCartaCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                                                    <Button Grid.Column="6" Content="{DynamicResource Boton.Abrir}" Padding="10,4" FontSize="12"
                                                            Style="{StaticResource BotonSecundario}"
                                                            Command="{Binding DataContext.AbrirCartaCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- Historial -->
                                        <Grid Margin="0,18,0,2">
                                            <TextBlock Text="{DynamicResource Historial.Titulo}" Style="{StaticResource TituloSeccion}"
                                                       Margin="9,0,0,0" VerticalAlignment="Center" />
                                            <Button Content="{DynamicResource Historial.Anadir}" HorizontalAlignment="Right"
                                                    Padding="10,4" FontSize="12"
                                                    Style="{StaticResource BotonSecundario}"
                                                    Command="{Binding DataContext.AnadirEventoCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Margin="0,0,9,0" />
                                        </Grid>

                                        <ItemsControl ItemsSource="{Binding Eventos}" Margin="9,6,9,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{StaticResource Borde}" BorderThickness="1"
                                                            CornerRadius="6" Padding="8" Margin="0,0,0,6">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <DatePicker Grid.Row="0" Grid.Column="0" Width="120"
                                                                        FontSize="12"
                                                                        SelectedDate="{Binding Fecha}" />

                                                            <ComboBox Grid.Row="0" Grid.Column="1" Margin="6,0,0,0"
                                                                      FontSize="12"
                                                                      ItemsSource="{Binding DataContext.TiposEvento, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                                      DisplayMemberPath="Descripcion"
                                                                      SelectedValuePath="Valor"
                                                                      SelectedValue="{Binding Tipo}" />

                                                            <Button Grid.Row="0" Grid.Column="2" Content="✕"
                                                                    Margin="6,0,0,0" Padding="8,3" FontSize="12"
                                                                    Style="{StaticResource BotonPeligro}"
                                                                    Command="{Binding DataContext.EliminarEventoCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                                    CommandParameter="{Binding}" />

                                                            <TextBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                                                     Margin="0,6,0,0" FontSize="12"
                                                                     Style="{StaticResource Campo}"
                                                                     Text="{Binding Descripcion}" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>

                        </TabControl>

                        <!-- Acciones -->
                        <Border Grid.Row="2" BorderBrush="{StaticResource Borde}" BorderThickness="0,1,0,0"
                                Padding="18,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" Content="{DynamicResource Boton.Eliminar}"
                                        Style="{StaticResource BotonPeligro}"
                                        Command="{Binding EliminarCommand}" Margin="9,0,0,0" />

                                <Button Grid.Column="1" Content="{DynamicResource Boton.Duplicar}" Margin="8,0,0,0"
                                        Style="{StaticResource BotonSecundario}"
                                        Command="{Binding DuplicarCommand}" />

                                <Button Grid.Column="3" Content="{DynamicResource Boton.Cancelar}" Margin="0,0,8,0"
                                        Style="{StaticResource BotonSecundario}"
                                        Command="{Binding CancelarCommand}" />

                                <Button Grid.Column="4" Content="{DynamicResource Boton.Guardar}"
                                        Style="{StaticResource BotonPrimario}"
                                        Command="{Binding GuardarCommand}" Margin="0,0,9,0" />
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ===================== BANDEJA DEL SISTEMA ===================== -->
        <tb:TaskbarIcon x:Name="IconoBandeja"
                        ToolTipText="{DynamicResource TituloVentana}"
                        TrayMouseDoubleClick="IconoBandeja_DobleClic">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="{DynamicResource Bandeja.Abrir}" Click="MenuAbrir_Click" />
                    <MenuItem Header="{DynamicResource Bandeja.Comprobar}" Click="MenuComprobar_Click" />
                    <Separator />
                    <MenuItem Header="{DynamicResource Bandeja.Salir}" Click="MenuSalir_Click" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
    </Grid>
</Window>