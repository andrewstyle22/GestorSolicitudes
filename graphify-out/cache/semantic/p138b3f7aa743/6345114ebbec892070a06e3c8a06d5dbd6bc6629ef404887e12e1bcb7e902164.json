{"nodes": [{"id": "_opencode_skills_sonarcloud_gate_skill_sonarcloud_gate", "label": "Skill sonarcloud-gate", "file_type": "document", "source_file": ".opencode/skills/sonarcloud-gate/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deja el gate de SonarCloud en verde antes de commitear o abrir PR; el veredicto real solo llega tras el push con el check de GitHub del PR."}, {"id": "_opencode_skills_sonarcloud_gate_skill_quality_gate_sonar_way", "label": "Quality Gate Sonar way (solo codigo nuevo)", "file_type": "concept", "source_file": ".opencode/skills/sonarcloud-gate/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "El gate del PR solo evalua el codigo nuevo, no la cobertura global del proyecto."}, {"id": "_opencode_skills_sonarcloud_gate_skill_new_code_coverage", "label": "New Code Coverage >= 80%", "file_type": "concept", "source_file": ".opencode/skills/sonarcloud-gate/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Condicion que suele fallar; se mide (CT + LC) / (B + EL), asi que una condicion sin cubrir pesa como una linea sin cubrir."}, {"id": "_opencode_skills_sonarcloud_gate_skill_new_code_duplication", "label": "New Code Duplication <= 3%", "file_type": "concept", "source_file": ".opencode/skills/sonarcloud-gate/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Extraer un helper sin conectar deja dos copias y Sonar marca la nueva; hay que conectar el helper y borrar la copia vieja."}, {"id": "_opencode_skills_sonarcloud_gate_skill_umbral_20_lineas", "label": "Umbral de 20 lineas nuevas", "file_type": "concept", "source_file": ".opencode/skills/sonarcloud-gate/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Con menos de 20 lineas de codigo nuevo, cobertura y duplicacion se ignoran: permite excluir del analisis un fichero sin reporte de cobertura."}, {"id": "_opencode_skills_sonarcloud_gate_skill_barrido_patrones", "label": "Barrido de patrones antes de cerrar issues", "file_type": "concept", "source_file": ".opencode/skills/sonarcloud-gate/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sonar no corre en local, pero IDisposable sin Dispose, foreach+if, literales repetidos, arrays constantes y First/Last/ElementAt se detectan con grep/Select-String antes del commit."}, {"id": "_opencode_skills_sonarcloud_gate_skill_idialogoservice", "label": "Convencion IDialogoService", "file_type": "concept", "source_file": ".opencode/skills/sonarcloud-gate/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "MessageBox/OpenFileDialog/SaveFileDialog/Process.Start solo viven en DialogoService (Views); la logica de comandos se prueba con DialogoFalso, asi que la cobertura se arregla probando el comando, no excluyendolo."}], "edges": [{"source": "_opencode_skills_sonarcloud_gate_skill_sonarcloud_gate", "target": "_opencode_skills_sonarcloud_gate_skill_quality_gate_sonar_way", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".opencode/skills/sonarcloud-gate/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_opencode_skills_sonarcloud_gate_skill_sonarcloud_gate", "target": "_opencode_skills_sonarcloud_gate_skill_new_code_coverage", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".opencode/skills/sonarcloud-gate/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_opencode_skills_sonarcloud_gate_skill_sonarcloud_gate", "target": "_opencode_skills_sonarcloud_g