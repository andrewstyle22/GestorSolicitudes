{"nodes": [{"id": "_opencode_skills_sonarcloud_gate_referencia_referencia", "label": "Referencia de SonarCloud", "file_type": "document", "source_file": ".opencode/skills/sonarcloud-gate/referencia.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Material de consulta solo cuando Sonar marca un issue o el gate falla: receta de cobertura, reglas del analizador ya sufridas y errores cometidos."}, {"id": "_opencode_skills_sonarcloud_gate_referencia_cobertura_cero_debugtype", "label": "Cobertura 0,0% por DebugType None", "file_type": "concept", "source_file": ".opencode/skills/sonarcloud-gate/referencia.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sin PDB coverlet no asocia puntos de secuencia y genera un OpenCover vacio; None solo hace falta al publicar, asi que se condiciona a Release."}, {"id": "_opencode_skills_sonarcloud_gate_referencia_estrategia_cobertura_mainviewmodel", "label": "Estrategia de cobertura de MainViewModel", "file_type": "concept", "source_file": ".opencode/skills/sonarcloud-gate/referencia.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cuello de botella del repo: extraer la logica a metodos internal/internal static y cubrirlos con xUnit, antes de plantear exclusiones."}, {"id": "_opencode_skills_sonarcloud_gate_referencia_excludefromcodecoverage", "label": "Regla de [ExcludeFromCodeCoverage]", "file_type": "concept", "source_file": ".opencode/skills/sonarcloud-gate/referencia.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Solo si TODAS las lineas del metodo estan sin cubrir: excluir un metodo con lineas cubiertas las borra del numerador y baja la cobertura."}, {"id": "_opencode_skills_sonarcloud_gate_referencia_formula_cobertura", "label": "Formula de cobertura (CT + LC) / (B + EL)", "file_type": "concept", "source_file": ".opencode/skills/sonarcloud-gate/referencia.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "El gate mezcla lineas y condiciones; codigo nuevo es lo anadido respecto al merge-base del PR, y una linea modificada del diff cuenta."}, {"id": "_opencode_skills_sonarcloud_gate_referencia_medicion_local", "label": "Medicion local != Sonar", "file_type": "concept", "source_file": ".opencode/skills/sonarcloud-gate/referencia.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "La medicion local del diff sobrestima 5-20 puntos porque Sonar cuenta regiones reescritas y condiciones que las herramientas locales ignoran; solo vale como estimacion."}, {"id": "_opencode_skills_sonarcloud_gate_referencia_s2930", "label": "S2930 Dispose IDisposable en campos", "file_type": "concept", "source_file": ".opencode/skills/sonarcloud-gate/referencia.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Es un bug, no un estilo, y el unico que puso el gate en rojo; una Window se cancela y libera en Closed."}, {"id": "_opencode_skills_sonarcloud_gate_referencia_s3267", "label": "S3267 foreach simplificable con Where", "file_type": "concept", "source_file": ".opencode/skills/sonarcloud-gate/referencia.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cuidado con efectos secundarios: en MainWindow el Where filtra y marca el id en la misma pasada."}, {"id": "_opencode_skills_sonarcloud_gate_referencia_s1192", "label": "S1192 Literal repetido 3+ veces", "file_type": "concept", "source_file": ".opencode/skills/sonarcloud-gate/referencia.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Un literal repetido 3 o mas veces en el mismo fichero va a private const string; las claves repetidas en los tres diccionarios de Traducciones.cs no cuentan."}, {"id": "_opencode_skills_sonarcloud_gate_referencia_s1117", "label": "S1117 Local que oculta el campo", "file_type": "concept", "source_file": ".opencode/skills/sonarcloud-gate/referencia.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Renombrar la local o el parametro y dejar el campo; con [ObservableProperty] el campo privado y la propiedad comparten nombre en PascalCase."}, {"id": "_opencode_skills_sonarcloud_gate_referencia_s6444", "label": "S6444 Regex sin timeout", "file_type": "concept", "source_file": ".opencode/skills/sonarcloud-gate/referencia.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Todo Regex sobre texto que viene de un fichero lleva timeout para no ser vulnerable a ReDoS."}, {"id": "_opencode_skills_sonarcloud_gate_referencia_s6966", "label": "S6966 E/S sincrona en metodo async", "file_type": "concept", "source_file": ".opencode/skills/sonarcloud-gate/referencia.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Si el metodo es async, no se llaman APIs de E/S bloqueantes de fichero: version ...Async con await."}, {"id": "_opencode_skills_sonarcloud_gate_referencia_s6602", "label": "S6602 First/Last/ElementAt sobre coleccion indexable", "file_type": "concept", "source_file": ".opencode/skills/sonarcloud-gate/referencia.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sobre List/array/IReadOnlyList se usa el indice; los metodos LINQ sin predicado delatan que la coleccion ya es indexable."}, {"id": "_opencode_skills_sonarcloud_gate_referencia_s3878", "label": "S3878 Arrays literales en llamadas", "file_type": "concept", "source_file": ".opencode/skills/sonarcloud-gate/referencia.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Usar private static readonly o evitar el array con Take/Skip en lugar de crear arrays literales en cada llamada."}, {"id": "_opencode_skills_sonarcloud_gate_referencia_s6612", "label": "S6612 Inicializacion de coleccion simplificada", "file_type": "concept", "source_file": ".opencode/skills/sonarcloud-gate/referencia.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "= new() pasa a expresion de coleccion []; solo vale como inicializador, no como argumento de metodo."}, {"id": "_opencode_skills_sonarcloud_gate_referencia_s1135", "label": "S1135 TODO (y el 'todo' espanol)", "file_type": "concept", "source_file": ".opencode/skills/sonarcloud-gate/referencia.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "La regla tambien muerde el 'todo' espanol de los comentarios: se reescribe la frase en vez de anadir NOSONAR."}, {"id": "_opencode_skills_sonarcloud_gate_referencia_s3881", "label": "S3881/CA1816 Patron IDisposable", "file_type": "concept", "source_file": ".opencode/skills/sonarcloud-gate/referencia.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Se sella la clase y se llama a GC.SuppressFinalize(this); no se anade un finalizador solo para callar la regla."}], "edges": [{"source": "_opencode_skills_sonarcloud_gate_referencia_referencia", "target": "_opencode_skills_sonarcloud_gate_referencia_cobertura_cero_debugtype", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".opencode/skills/sonarcloud-gate/referencia.md", "source_location": null, "weight": 1.0}, {"source": "_opencode_skills_sonarcloud_gate_referencia_referencia", "target": "_opencode_skills_sonarcloud_gate_referencia_estrategia_cobertura_mainviewmodel", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".opencode/skills/sonarcloud-gate/referencia.md", "source_location": null, "weight": 1.0}, {"source": "_opencode_skills_sonarcloud_gate_referencia_referencia", "target": "_opencode_skills_sonarcloud_gate_referencia_excludefromcodecoverage", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".opencode/skills/sonarcloud-gate/referencia.md", "source_location": null, "weight": 1.0}, {"source": "_opencode_skills_sonarcloud_gate_referencia_referencia", "target": "_opencode_skills_sonarcloud_gate_referencia_formula_cobertura", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".opencode/skills/sonarcloud-gate/referencia.md", "source_location": null, "weight": 1.0}, {"source": "_opencode_skills_sonarcloud_gate_referencia_referencia", "target": "_opencode_skills_sonarcloud_gate_referencia_medicion_local", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".opencode/skills/sonarcloud-gate/referencia.md", "source_location": null, "weight": 1.0}, {"source": "_opencode_skills_sonarcloud_gate_referencia_referencia", "target": "_opencode_skills_sonarcloud_gate_referencia_s2930", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".opencode/skills/sonarcloud-gate/referencia.md", "source_location": null, "weight": 1.0}, {"source": "_opencode_skills_sonarcloud_gate_referencia_referencia", "target": "_opencode_skills_sonarcloud_gate_referencia_s3267", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".opencode/skills/sonarcloud-gate/referencia.md", "source_location": null, "weight": 1.0}, {"source": "_opencode_skills_sonarcloud_gate_referencia_referencia", "target": "_opencode_ski