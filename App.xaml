<Application x:Class="GestorSolicitudes.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:GestorSolicitudes.Converters"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>

        <!-- ============ Convertidores ============ -->
        <conv:EnumDescripcionConverter x:Key="EnumDescripcion" />
        <conv:NuloAVisibilidadConverter x:Key="NuloAVisibilidad" />
        <conv:EstadoAColorConverter x:Key="EstadoAColor" />
        <conv:InteresAColorEstrellaConverter x:Key="InteresAEstrella" />
        <conv:VerGraficaATextoConverter x:Key="VerGraficaATexto" />
        <conv:EstadoEsRechazadaAVisibilidadConverter x:Key="EstadoEsRechazadaAVisibilidad" />
        <conv:InteresATextoEstrellasConverter x:Key="InteresATextoEstrellas" />
        <conv:NuloACadenaConverter x:Key="NuloACadena" />
        <BooleanToVisibilityConverter x:Key="BooleanoAVisibilidad" />

        <!-- ============ Paleta ============ -->
        <SolidColorBrush x:Key="Fondo"       Color="#F1F5F9" />
        <SolidColorBrush x:Key="Panel"       Color="#FFFFFF" />
        <SolidColorBrush x:Key="Borde"       Color="#E2E8F0" />
        <SolidColorBrush x:Key="Texto"       Color="#0F172A" />
        <SolidColorBrush x:Key="TextoSuave"  Color="#64748B" />
        <SolidColorBrush x:Key="Acento"      Color="#2563EB" />
        <SolidColorBrush x:Key="Peligro"     Color="#DC2626" />
        <SolidColorBrush x:Key="Aviso"       Color="#FEF3C7" />
        <SolidColorBrush x:Key="Estrella"    Color="#F59E0B" />

        <!-- ============ Texto ============ -->
        <Style x:Key="Etiqueta" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextoSuave}" />
            <Setter Property="Margin" Value="0,10,0,3" />
        </Style>

        <Style x:Key="TituloSeccion" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource Texto}" />
            <Setter Property="Margin" Value="0,18,0,2" />
        </Style>

        <!-- ============ Campos ============ -->
        <Style x:Key="Campo" TargetType="TextBox">
            <Setter Property="Padding" Value="7,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="BorderBrush" Value="{StaticResource Borde}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="CampoMultilinea" TargetType="TextBox" BasedOn="{StaticResource Campo}">
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="MinHeight" Value="64" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        </Style>

        <Style x:Key="CampoCombo" TargetType="ComboBox">
            <Setter Property="Padding" Value="6,5" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style x:Key="CampoFecha" TargetType="DatePicker">
            <Setter Property="FontSize" Value="13" />
        </Style>

        <!-- ============ Botones ============ -->
        <Style x:Key="BotonBase" TargetType="Button">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="borde"
                                CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="borde" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="borde" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BotonPrimario" TargetType="Button" BasedOn="{StaticResource BotonBase}">
            <Setter Property="Background" Value="{StaticResource Acento}" />
            <Setter Property="BorderBrush" Value="{StaticResource Acento}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="BotonSecundario" TargetType="Button" BasedOn="{StaticResource BotonBase}">
            <Setter Property="Background" Value="{StaticResource Panel}" />
            <Setter Property="BorderBrush" Value="{StaticResource Borde}" />
            <Setter Property="Foreground" Value="{StaticResource Texto}" />
        </Style>

        <Style x:Key="BotonPeligro" TargetType="Button" BasedOn="{StaticResource BotonBase}">
            <Setter Property="Background" Value="{StaticResource Panel}" />
            <Setter Property="BorderBrush" Value="{StaticResource Peligro}" />
            <Setter Property="Foreground" Value="{StaticResource Peligro}" />
        </Style>

        <!-- Botón "fantasma": sin chrome propio, para iconos y estrellas donde solo
             debe pintar el símbolo (glifo) con el color que le diga el converter. -->
        <Style x:Key="BotonGlifo" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="2,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón secundario compacto, para acciones de un renglón (adjuntar, importar...) -->
        <Style x:Key="BotonSecundarioCompacto" TargetType="Button" BasedOn="{StaticResource BotonSecundario}">
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <!-- ============ Pestañas del panel de detalle ============ -->
        <Style x:Key="Pestana" TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextoSuave}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="marco"
                                BorderBrush="Transparent"
                                BorderThickness="0,0,0,2"
                                Padding="12,7"
                                Margin="0,0,4,-1">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="marco" Property="BorderBrush" Value="{StaticResource Acento}" />
                                <Setter Property="Foreground" Value="{StaticResource Texto}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Texto}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Pestanas" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Padding="18,0"
                                    BorderBrush="{StaticResource Borde}" BorderThickness="0,0,0,1">
                                <TabPanel IsItemsHost="True" />
                            </Border>
                            <Border Grid.Row="1" Padding="18,12,18,14">
                                <ContentPresenter ContentSource="SelectedContent" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Application.Resources>
</Application>
